<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Keep recording with the screen off or in another app, like a voice recorder. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- One buzz when the words are typed in, two when the 10-minute cap stops it. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only used once, to download the speech model. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Utter"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Utter"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Watches for text boxes getting focus, shows the floating mic, and types the words in. -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:label="Utter voice typing"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
